use ggez::conf::{WindowMode, WindowSetup};
use ggez::event::{self, EventHandler, MouseButton};
use ggez::glam::*;
use ggez::graphics::{self, Color, DrawMode, DrawParam, Mesh, Rect, Text, TextFragment};
use ggez::{Context, ContextBuilder, GameError, GameResult};
use std::collections::HashMap;
use std::sync::mpsc; // 使用标准库的 channel 即可
use std::thread;
use std::time::{Duration, Instant};

// --- Constants ---
const BOARD_SIZE: usize = 15;
const CELL_SIZE: f32 = 40.0;
const MARGIN: f32 = 50.0;
const BOARD_DIM: f32 = CELL_SIZE * (BOARD_SIZE as f32 - 1.0);
const WINDOW_WIDTH: f32 = BOARD_DIM + 2.0 * MARGIN;
const WINDOW_HEIGHT: f32 = BOARD_DIM + 2.0 * MARGIN + 50.0; // Extra space for text
const PIECE_RADIUS: f32 = CELL_SIZE * 0.45;
const DOT_RADIUS: f32 = 4.0;
const HIGHLIGHT_SIZE: f32 = CELL_SIZE * 0.2;

const AI_DEPTH: u32 = 4; // AI 搜索深度，可以调整

const SCORE_FIVE: i32 = 100_000; // 连五
const SCORE_LIVE_FOUR: i32 = 10_000; // 活四
const SCORE_DEAD_FOUR: i32 = 1_000; // 冲四 / 死四
const SCORE_LIVE_THREE: i32 = 1_000; // 活三
const SCORE_DEAD_THREE: i32 = 100; // 死三
const SCORE_LIVE_TWO: i32 = 100; // 活二
const SCORE_DEAD_TWO: i32 = 10; // 死二
const SCORE_LIVE_ONE: i32 = 10; // 活一
const SCORE_DEAD_ONE: i32 = 1; // 死一

// --- Enums and Structs ---

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
enum Player {
    Black,
    White,
}

impl Player {
    fn opponent(&self) -> Player {
        match self {
            Player::Black => Player::White,
            Player::White => Player::Black,
        }
    }

    fn color(&self) -> Color {
        match self {
            Player::Black => Color::BLACK,
            Player::White => Color::WHITE,
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
enum GamePhase {
    ChooseSide,
    Playing,
    GameOver,
}

#[derive(Debug, Clone, Copy, PartialEq)]
enum GameResultState {
    Winner(Player),
    Draw,
}

type Board = [[Option<Player>; BOARD_SIZE]; BOARD_SIZE];

struct GameState {
    board: Board,
    current_player: Player,
    human_player: Player, // 人类玩家执子颜色
    phase: GamePhase,
    game_result: Option<GameResultState>,
    last_move: Option<(usize, usize)>,
    move_history: Vec<(usize, usize, Player)>,
    ai_thinking: bool,
    ai_move_receiver: Option<mpsc::Receiver<(usize, usize)>>, // Channel to receive AI move
    ai_thread_handle: Option<thread::JoinHandle<()>>,         // Handle to AI thread
    status_text: String,
}

impl GameState {
    fn new(_ctx: &mut Context) -> GameResult<GameState> {
        Ok(GameState {
            board: [[None; BOARD_SIZE]; BOARD_SIZE],
            current_player: Player::Black, // 黑子先行
            human_player: Player::Black,   // 默认人类执黑
            phase: GamePhase::ChooseSide,  // 开始时选择执子
            game_result: None,
            last_move: None,
            move_history: Vec::new(),
            ai_thinking: false,
            ai_move_receiver: None,
            ai_thread_handle: None,
            status_text: "Choose your side: Press 'B' for Black, 'W' for White".to_string(),
        })
    }

    // 将屏幕坐标转换为棋盘格子坐标
    fn screen_to_grid(&self, x: f32, y: f32) -> Option<(usize, usize)> {
        if x < MARGIN - CELL_SIZE / 2.0
            || x > MARGIN + BOARD_DIM + CELL_SIZE / 2.0
            || y < MARGIN - CELL_SIZE / 2.0
            || y > MARGIN + BOARD_DIM + CELL_SIZE / 2.0
        {
            return None; // 点击位置在棋盘外
        }

        let grid_x = ((x - MARGIN + CELL_SIZE / 2.0) / CELL_SIZE).floor() as usize;
        let grid_y = ((y - MARGIN + CELL_SIZE / 2.0) / CELL_SIZE).floor() as usize;

        if grid_x < BOARD_SIZE && grid_y < BOARD_SIZE {
            Some((grid_x, grid_y))
        } else {
            None // 确保坐标在有效范围内
        }
    }

    // 将棋盘格子坐标转换为屏幕中心坐标
    fn grid_to_screen(&self, x: usize, y: usize) -> Vec2 {
        Vec2::new(MARGIN + x as f32 * CELL_SIZE, MARGIN + y as f32 * CELL_SIZE)
    }

    // 尝试下棋
    fn make_move(&mut self, x: usize, y: usize, player: Player) -> Result<(), &'static str> {
        if self.game_result.is_some() {
            return Err("Game is already over.");
        }
        if x >= BOARD_SIZE || y >= BOARD_SIZE {
            return Err("Move out of bounds.");
        }
        if self.board[y][x].is_some() {
            return Err("Cell is already occupied.");
        }

        self.board[y][x] = Some(player);
        self.last_move = Some((x, y));
        self.move_history.push((x, y, player));

        if self.check_win(x, y, player) {
            self.phase = GamePhase::GameOver;
            self.game_result = Some(GameResultState::Winner(player));
            self.status_text = format!(
                "{} wins! Press 'R' to restart.",
                if player == Player::Black {
                    "Black"
                } else {
                    "White"
                }
            );
        } else if self.check_draw() {
            self.phase = GamePhase::GameOver;
            self.game_result = Some(GameResultState::Draw);
            self.status_text = "It's a draw! Press 'R' to restart.".to_string();
        } else {
            self.current_player = player.opponent();
            self.update_status_text();
        }

        Ok(())
    }

    // 检查是否获胜
    fn check_win(&self, x: usize, y: usize, player: Player) -> bool {
        let directions = [(0, 1), (1, 0), (1, 1), (1, -1)]; // 水平, 垂直, 右下, 右上

        for (dx, dy) in directions {
            let mut count = 1;

            // 正方向搜索
            for i in 1..5 {
                let nx = x as isize + dx * i;
                let ny = y as isize + dy * i;
                if nx >= 0
                    && nx < BOARD_SIZE as isize
                    && ny >= 0
                    && ny < BOARD_SIZE as isize
                    && self.board[ny as usize][nx as usize] == Some(player)
                {
                    count += 1;
                } else {
                    break;
                }
            }

            // 反方向搜索
            for i in 1..5 {
                let nx = x as isize - dx * i;
                let ny = y as isize - dy * i;
                if nx >= 0
                    && nx < BOARD_SIZE as isize
                    && ny >= 0
                    && ny < BOARD_SIZE as isize
                    && self.board[ny as usize][nx as usize] == Some(player)
                {
                    count += 1;
                } else {
                    break;
                }
            }

            if count >= 5 {
                return true;
            }
        }
        false
    }

    // 检查是否平局
    fn check_draw(&self) -> bool {
        self.move_history.len() == BOARD_SIZE * BOARD_SIZE
    }

    // 悔棋
    fn undo_move(&mut self) {
        if self.phase != GamePhase::Playing || self.ai_thinking {
            println!("Cannot undo now.");
            return;
        }

        // 如果当前是 AI 的回合，说明是玩家刚下完，AI还没开始思考或刚思考完
        // 此时悔棋需要撤销玩家和 AI 的上一步棋
        // 如果当前是玩家的回合，说明是 AI 刚下完
        // 此时悔棋也需要撤销 AI 和玩家的上一步棋
        let num_moves_to_undo =
            if self.move_history.len() >= 2 && self.current_player != self.human_player {
                // AI刚下完，轮到人了
                2 // 撤销 AI 和人的棋
            } else if self.move_history.len() >= 1 && self.current_player == self.human_player {
                // 人刚下完，轮到AI了
                // 如果是人机对战，且历史记录至少有两步，则撤销两步
                if self.move_history.len() >= 2 {
                    2
                } else {
                    1
                } // 否则只撤销一步（例如人执白第一步）
            } else if self.move_history.len() >= 1 {
                1 // 其他情况（例如刚开始，或只有一步历史）
            } else {
                0 // 没有棋可悔
            };

        if num_moves_to_undo == 0 {
            println!("No moves to undo.");
            return;
        }

        for _ in 0..num_moves_to_undo {
            if let Some((x, y, player)) = self.move_history.pop() {
                self.board[y][x] = None;
                self.current_player = player; // 恢复到下这步棋之前的玩家
            }
        }

        // 更新 last_move
        self.last_move = self.move_history.last().map(|(x, y, _)| (*x, *y));
        self.game_result = None; // 游戏不再结束
        self.phase = GamePhase::Playing; // 确保回到游戏状态
        self.update_status_text();
        println!("Undo successful. {} moves undone.", num_moves_to_undo);
    }

    // 重置游戏
    fn reset_game(&mut self) {
        self.board = [[None; BOARD_SIZE]; BOARD_SIZE];
        self.current_player = Player::Black;
        self.phase = GamePhase::ChooseSide;
        self.game_result = None;
        self.last_move = None;
        self.move_history.clear();
        self.ai_thinking = false;
        // 清理可能存在的 AI 线程和通道
        if let Some(handle) = self.ai_thread_handle.take() {
            // 这里不 join，让它自生自灭，避免阻塞
            // handle.join().expect("AI thread panicked during reset");
        }
        self.ai_move_receiver = None;
        self.status_text = "Choose your side: Press 'B' for Black, 'W' for White".to_string();
    }

    // 更新状态文本
    fn update_status_text(&mut self) {
        if self.phase == GamePhase::GameOver {
            // Game over text is set in make_move
            return;
        }
        if self.phase == GamePhase::ChooseSide {
            self.status_text = "Choose your side: Press 'B' for Black, 'W' for White".to_string();
            return;
        }

        let current_player_name = if self.current_player == Player::Black {
            "Black"
        } else {
            "White"
        };
        let turn_info = if self.current_player == self.human_player {
            format!("Your turn ({})", current_player_name)
        } else {
            "AI is thinking...".to_string()
        };
        self.status_text = format!("{} | Press 'U' to Undo, 'R' to Restart", turn_info);
    }

    // 触发 AI 思考
    fn trigger_ai_move(&mut self) {
        if self.current_player == self.human_player
            || self.phase != GamePhase::Playing
            || self.ai_thinking
        {
            return;
        }

        self.ai_thinking = true;
        self.update_status_text(); // 显示 "AI is thinking..."

        let (sender, receiver) = mpsc::channel();
        self.ai_move_receiver = Some(receiver);

        let current_board = self.board; // 复制棋盘状态
        let ai_player = self.current_player; // AI执子颜色

        self.ai_thread_handle = Some(thread::spawn(move || {
            let start_time = Instant::now();
            println!("AI ({:?}) starting minimax...", ai_player);
            let best_move = find_best_move(current_board, ai_player, AI_DEPTH);
            let duration = start_time.elapsed();
            println!(
                "AI ({:?}) finished in {:?}. Best move: {:?}",
                ai_player, duration, best_move
            );

            if let Some(mv) = best_move {
                // 发送结果，忽略发送错误（如果主线程已经退出了）
                let _ = sender.send(mv);
            } else {
                // 如果 AI 找不到合适的移动（理论上不应该在游戏未结束时发生）
                // 可以选择一个随机的空位，或者 panic
                println!("AI Error: No valid move found!");
                // 寻找第一个空位作为备用
                let fallback_move = find_first_empty_cell(current_board);
                if let Some(mv) = fallback_move {
                    let _ = sender.send(mv);
                }
            }
        }));
    }

    // 处理 AI 计算结果
    fn handle_ai_result(&mut self) {
        if let Some(receiver) = &self.ai_move_receiver {
            match receiver.try_recv() {
                Ok((x, y)) => {
                    // 收到 AI 的移动
                    let ai_player = self.current_player;
                    match self.make_move(x, y, ai_player) {
                        Ok(_) => {
                            println!("AI placed at ({}, {})", x, y);
                        }
                        Err(e) => {
                            // AI 算出的位置非法？这通常是 AI 实现或状态同步的 bug
                            eprintln!("AI Error: Invalid move ({}, {}) calculated: {}", x, y, e);
                            // 尝试找一个备用位置？或者让游戏出错？
                            // 这里简单地跳过这个回合，让玩家继续，但这表明有更深层的问题
                            self.current_player = ai_player.opponent();
                        }
                    }
                    self.ai_thinking = false;
                    self.ai_move_receiver = None; // 清除通道
                    self.ai_thread_handle = None; // 清除句柄
                    self.update_status_text(); // 更新状态为玩家回合
                }
                Err(mpsc::TryRecvError::Empty) => {
                    // AI 还在计算中
                }
                Err(mpsc::TryRecvError::Disconnected) => {
                    // AI 线程意外结束
                    eprintln!("AI thread disconnected unexpectedly!");
                    self.ai_thinking = false;
                    self.ai_move_receiver = None;
                    self.ai_thread_handle = None;
                    // 可以尝试重新触发 AI 或显示错误信息
                    self.status_text = "AI Error! Press 'R' to restart.".to_string();
                    self.phase = GamePhase::GameOver; // Or some error state
                }
            }
        }
    }
}

// --- AI Logic ---

// AI 主函数：找到最佳移动
fn find_best_move(board: Board, ai_player: Player, depth: u32) -> Option<(usize, usize)> {
    let (_, best_move_opt) = minimax(board, depth, i32::MIN, i32::MAX, true, ai_player);
    best_move_opt
}

// Minimax 算法（带 Alpha-Beta 剪枝）
// maximizing_player: 当前是否是轮到 AI (ai_player) 这个最大化分数者下棋
// ai_player: AI 执子的颜色
// 返回值: (最佳分数, 最佳移动 Option<(usize, usize)>)
fn minimax(
    mut board: Board, // 传入可变副本，便于模拟下棋和撤销
    depth: u32,
    mut alpha: i32,
    mut beta: i32,
    maximizing_player: bool,
    ai_player: Player,
) -> (i32, Option<(usize, usize)>) {
    // 检查是否有立即可获胜或失败的情况 (优化：可以在评估函数中处理)
    if let Some(winner) = check_immediate_win(&board) {
        let score = if winner == ai_player {
            SCORE_FIVE
        } else {
            -SCORE_FIVE
        };
        // 确保分数与深度相关，尽快获胜/推迟失败
        return (score - depth as i32, None); // 减去深度惩罚慢速胜利，或奖励快速失败（对对手而言）
    }
    if is_board_full(&board) {
        return (0, None); // 平局
    }
    // 到达搜索深度限制，或者游戏已经结束，进行评估
    if depth == 0 {
        return (evaluate_board(&board, ai_player), None);
    }

    let current_eval_player = if maximizing_player {
        ai_player
    } else {
        ai_player.opponent()
    };
    let moves = generate_moves(&board); // 获取候选移动

    if moves.is_empty() {
        // 没有可行的移动了（可能是平局或bug）
        return (evaluate_board(&board, ai_player), None);
    }

    let mut best_move: Option<(usize, usize)> = None;

    if maximizing_player {
        // AI (ai_player) 的回合，目标是最大化分数
        let mut max_eval = i32::MIN;
        for (x, y) in moves {
            board[y][x] = Some(current_eval_player); // 模拟下棋
            let (eval, _) = minimax(board, depth - 1, alpha, beta, false, ai_player);
            board[y][x] = None; // 撤销模拟

            if eval > max_eval {
                max_eval = eval;
                best_move = Some((x, y));
            }
            alpha = alpha.max(eval);
            if beta <= alpha {
                break; // Beta 剪枝
            }
        }
        (max_eval, best_move)
    } else {
        // 对手 (ai_player.opponent()) 的回合，目标是最小化 AI 的分数
        let mut min_eval = i32::MAX;
        for (x, y) in moves {
            board[y][x] = Some(current_eval_player); // 模拟下棋
            let (eval, _) = minimax(board, depth - 1, alpha, beta, true, ai_player);
            board[y][x] = None; // 撤销模拟

            if eval < min_eval {
                min_eval = eval;
                best_move = Some((x, y)); // Note: Minimax usually only needs the move at the top level
            }
            beta = beta.min(eval);
            if beta <= alpha {
                break; // Alpha 剪枝
            }
        }
        (min_eval, best_move) // Return best move found at this minimizing level
    }
}

// 检查棋盘是否已满
fn is_board_full(board: &Board) -> bool {
    board
        .iter()
        .all(|row| row.iter().all(|cell| cell.is_some()))
}

// 检查是否有玩家已经获胜 (用于 minimax 提前终止)
fn check_immediate_win(board: &Board) -> Option<Player> {
    for r in 0..BOARD_SIZE {
        for c in 0..BOARD_SIZE {
            if let Some(player) = board[r][c] {
                // 检查从 (c, r) 开始的四个方向
                if c + 4 < BOARD_SIZE && (1..5).all(|i| board[r][c + i] == Some(player)) {
                    return Some(player);
                } // 水平
                if r + 4 < BOARD_SIZE && (1..5).all(|i| board[r + i][c] == Some(player)) {
                    return Some(player);
                } // 垂直
                if c + 4 < BOARD_SIZE
                    && r + 4 < BOARD_SIZE
                    && (1..5).all(|i| board[r + i][c + i] == Some(player))
                {
                    return Some(player);
                } // 右下
                if c >= 4
                    && r + 4 < BOARD_SIZE
                    && (1..5).all(|i| board[r + i][c - i] == Some(player))
                {
                    return Some(player);
                } // 左下 (检查方向改为左下)
            }
        }
    }
    None
}

// 生成候选移动 (优化：只考虑已有棋子附近的空位)
fn generate_moves(board: &Board) -> Vec<(usize, usize)> {
    let mut moves = Vec::new();
    let mut visited = [[false; BOARD_SIZE]; BOARD_SIZE];
    // const SEARCH_RANGE: usize = 2; // <--- 原来的范围
    const SEARCH_RANGE: usize = 1; // <--- 缩小邻域范围到 1

    let mut has_pieces = false; // 标记棋盘上是否有棋子

    // 优化：使用 HashSet 存储考虑过的空位，避免 visited 数组开销？但数组可能更快
    let mut relevant_empty_cells = std::collections::HashSet::new();

    for r in 0..BOARD_SIZE {
        for c in 0..BOARD_SIZE {
            if board[r][c].is_some() {
                has_pieces = true;
                // 检查邻域内的空位
                let min_r = r.saturating_sub(SEARCH_RANGE);
                let max_r = (r + SEARCH_RANGE).min(BOARD_SIZE - 1);
                let min_c = c.saturating_sub(SEARCH_RANGE);
                let max_c = (c + SEARCH_RANGE).min(BOARD_SIZE - 1);

                for nr in min_r..=max_r {
                    for nc in min_c..=max_c {
                        if board[nr][nc].is_none() {
                            relevant_empty_cells.insert((nc, nr));
                        }
                    }
                }
            }
        }
    }

    // 如果棋盘上还没有棋子（开局第一步）
    if !has_pieces {
        // 直接返回中心点 +/- 1 的区域，或者就返回中心点
        moves.push((BOARD_SIZE / 2, BOARD_SIZE / 2));
        // 可以考虑多加几个，例如:
        // for dr in -1..=1 {
        //     for dc in -1..=1 {
        //         let r = (BOARD_SIZE / 2) as isize + dr;
        //         let c = (BOARD_SIZE / 2) as isize + dc;
        //         if r >= 0 && r < BOARD_SIZE as isize && c >= 0 && c < BOARD_SIZE as isize {
        //            if board[r as usize][c as usize].is_none() { // 虽然知道是空的，但以防万一
        //                 moves.push((c as usize, r as usize));
        //            }
        //         }
        //     }
        // }
    } else {
        // 将 HashSet 中的坐标转换成 Vec
        moves = relevant_empty_cells.into_iter().collect();

        // 如果 relevant_empty_cells 为空（极端情况？），添加一个 fallback
        if moves.is_empty() {
            if let Some(fallback) = find_first_empty_cell(*board) {
                // 注意这里 board 需要是 Board 类型
                moves.push(fallback);
            }
        }
    }

    // --- (可选) 简单移动排序 ---
    // 这里可以加入一个简单的启发式排序，优先考虑靠近中心的、
    // 或者能形成/阻止三连、四连的步。
    // 这是一个相对复杂的补充，我们先不加，看看前面的优化效果。
    // moves.sort_by_key(|&(x, y)| {
    //     let dist_x = (x as i32 - BOARD_SIZE as i32 / 2).abs();
    //     let dist_y = (y as i32 - BOARD_SIZE as i32 / 2).abs();
    //     -(dist_x + dist_y) // 简单的中心度评分，取负数使靠近中心的排前面
    //     // 更复杂的评分需要模拟下棋并调用简化评估函数
    // });

    // println!("Generated {} moves.", moves.len()); // 调试输出候选移动数量
    moves
}

// (确保 find_first_empty_cell 函数存在且接受 Board)
// 找到第一个空格子（用于 AI 找不到移动时的备用方案）
fn find_first_empty_cell(board: Board) -> Option<(usize, usize)> {
    for r in 0..BOARD_SIZE {
        for c in 0..BOARD_SIZE {
            if board[r][c].is_none() {
                return Some((c, r));
            }
        }
    }
    None // 棋盘满了
}

// 检查 (x, y) 附近指定范围内是否有棋子
// fn has_neighbor(board: &Board, x: usize, y: usize, range: usize) -> bool {
//     let min_r = y.saturating_sub(range);
//     let max_r = (y + range).min(BOARD_SIZE - 1);
//     let min_c = x.saturating_sub(range);
