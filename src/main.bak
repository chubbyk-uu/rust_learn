// --- 评估函数 ---

// 评估整个棋盘状态
// 从 ai_player 的角度评估，分数越高对 ai_player 越有利
fn evaluate_board(board: &Board, ai_player: Player) -> i32 {
    let mut ai_score = 0;
    let mut opponent_score = 0;
    let opponent_player = ai_player.opponent();

    // 使用 HashMap 存储每个位置所属的棋型的最高得分，避免重复计算贡献
    // Key: (usize, usize), Value: i32 (该位置贡献的最高分数)
    let mut point_scores: HashMap<(usize, usize), i32> = HashMap::new();

    // 评估所有行、列、对角线
    let lines = get_all_lines(board);

    for line in lines {
        let (ai_line_score, opp_line_score) = evaluate_line(&line, ai_player, opponent_player);
        ai_score += ai_line_score;
        opponent_score += opp_line_score;
    }

    // 基础分数：AI分数 - 对手分数
    let score = ai_score - opponent_score;

    // println!("Board eval for {:?}: AI Score = {}, Opponent Score = {}, Final = {}", ai_player, ai_score, opponent_score, score);
    score
}

// 获取棋盘上所有的行、列、对角线（长度至少为5）
fn get_all_lines(board: &Board) -> Vec<Vec<Option<Player>>> {
    let mut lines = Vec::new();

    // 行
    for r in 0..BOARD_SIZE {
        lines.push(board[r].to_vec());
    }

    // 列
    for c in 0..BOARD_SIZE {
        let mut line = Vec::with_capacity(BOARD_SIZE);
        for r in 0..BOARD_SIZE {
            line.push(board[r][c]);
        }
        lines.push(line);
    }

    // 对角线 (右上到左下)
    for k in 0..=(2 * (BOARD_SIZE - 1)) {
        let mut line = Vec::new();
        let r_start = k.saturating_sub(BOARD_SIZE - 1);
        let r_end = k.min(BOARD_SIZE - 1);
        for r in r_start..=r_end {
            let c = k - r;
            if c < BOARD_SIZE {
                // 确保 c 在界内
                line.push(board[r][c]);
            }
        }
        if line.len() >= 5 {
            lines.push(line);
        }
    }

    // 对角线 (左上到右下)
    for k in -(BOARD_SIZE as isize - 1)..=(BOARD_SIZE as isize - 1) {
        let mut line = Vec::new();
        for r in 0..BOARD_SIZE {
            let c = r as isize + k;
            if c >= 0 && c < BOARD_SIZE as isize {
                line.push(board[r][c as usize]);
            }
        }
        if line.len() >= 5 {
            lines.push(line);
        }
    }

    lines
}

// 评估一条线上的棋型分数
// 返回 (ai_player在这条线上的分数, opponent_player在这条线上的分数)
fn evaluate_line(
    line: &[Option<Player>],
    ai_player: Player,
    opponent_player: Player,
) -> (i32, i32) {
    let mut ai_score = 0;
    let mut opp_score = 0;
    let n = line.len();

    // 遍历这条线上的所有长度为 5 或 6 的窗口来识别棋型
    // 长度为 6 的窗口用于识别 "活三" (_OOO__) 等需要两侧空格的棋型
    for i in 0..=(n.saturating_sub(5)) {
        let window5 = &line[i..(i + 5)];
        let (s_ai, s_opp) = score_window(window5, ai_player, opponent_player);
        ai_score += s_ai;
        opp_score += s_opp;

        // 检查长度为 6 的窗口，用于识别两侧开放的棋型
        if i + 6 <= n {
            let window6 = &line[i..(i + 6)];
            let (s_ai_6, s_opp_6) = score_window6(window6, ai_player, opponent_player);
            // 只加活棋的分数，避免和长度5的死棋重复计算？或者调整权重
            ai_score += s_ai_6;
            opp_score += s_opp_6;
        }
    }

    (ai_score, opp_score)
}

// 对长度为 5 的窗口进行打分
// 返回 (ai_player分数, opponent_player分数)
fn score_window(window: &[Option<Player>], ai: Player, opp: Player) -> (i32, i32) {
    let mut ai_count = 0;
    let mut opp_count = 0;
    for &cell in window {
        if cell == Some(ai) {
            ai_count += 1;
        } else if cell == Some(opp) {
            opp_count += 1;
        }
    }

    // 如果窗口内同时有双方棋子，则这个窗口不能形成连五，分数较低或为0
    if ai_count > 0 && opp_count > 0 {
        return (0, 0); // 或者根据情况给一些极低的分数？
    }

    // 根据棋子数量和是否被封堵（通过外侧格子判断，这里简化处理，只看数量）给分
    // 注意：更精确的评估需要看窗口两侧的格子状态（是否为空，是否为对手棋子）
    // 这里简化为：只看窗口内的棋子数量
    match (ai_count, opp_count) {
        (5, 0) => (SCORE_FIVE, 0),       // AI 连五
        (0, 5) => (0, SCORE_FIVE),       // 对手连五
        (4, 0) => (SCORE_DEAD_FOUR, 0),  // AI 死四 (需要结合window6判断活四)
        (0, 4) => (0, SCORE_DEAD_FOUR),  // 对手死四
        (3, 0) => (SCORE_DEAD_THREE, 0), // AI 死三 (需要结合window6判断活三)
        (0, 3) => (0, SCORE_DEAD_THREE), // 对手死三
        (2, 0) => (SCORE_DEAD_TWO, 0),   // AI 死二
        (0, 2) => (0, SCORE_DEAD_TWO),   // 对手死二
        (1, 0) => (SCORE_DEAD_ONE, 0),   // AI 死一
        (0, 1) => (0, SCORE_DEAD_ONE),   // 对手死一
        _ => (0, 0),
    }
}

// 对长度为 6 的窗口进行打分，主要用于识别活棋（两端为空）
fn score_window6(window: &[Option<Player>], ai: Player, opp: Player) -> (i32, i32) {
    // Check for patterns like _OOOO_, _OOO__, __OO__ etc.
    let mut ai_score = 0;
    let mut opp_score = 0;

    // 活四: _OOOO_
    if window[0].is_none() && window[5].is_none() && window[1..5].iter().all(|&c| c == Some(ai)) {
        ai_score += SCORE_LIVE_FOUR;
    } else if window[0].is_none()
        && window[5].is_none()
        && window[1..5].iter().all(|&c| c == Some(opp))
    {
        opp_score += SCORE_LIVE_FOUR;
    }

    // 活三: _OOO__ or __OOO_
    if window[0].is_none() && window[4].is_none() && window[1..4].iter().all(|&c| c == Some(ai)) {
        // _OOO_?
        // 需要检查 window[5] 是否为空或边界
        if window[5].is_none() {
            // _OOO__
            ai_score += SCORE_LIVE_THREE;
        }
    } else if window[0].is_none()
        && window[4].is_none()
        && window[1..4].iter().all(|&c| c == Some(opp))
    {
        if window[5].is_none() {
            // _OOO__
            opp_score += SCORE_LIVE_THREE;
        }
    }
    // __OOO_
    if window[1].is_none() && window[5].is_none() && window[2..5].iter().all(|&c| c == Some(ai)) {
        if window[0].is_none() {
            // __OOO_
            ai_score += SCORE_LIVE_THREE;
        }
    } else if window[1].is_none()
        && window[5].is_none()
        && window[2..5].iter().all(|&c| c == Some(opp))
    {
        if window[0].is_none() {
            // __OOO_
            opp_score += SCORE_LIVE_THREE;
        }
    }
    // 活三特殊： O_OO_ or _OO_O_ (算在window5的死三里，还是这里加分？)
    // 可以在 score_window 里更精细化，或在这里补充
    // 例如 O_OO_ : window[0]==P, window[1]==None, window[2]==P, window[3]==P, window[4]==None
    // 这里简单处理，主要靠 window6 识别两端开口的情况

    // 活二: _OO___, __OO__, ___OO_
    // _OO___
    if window[0].is_none() && window[3].is_none() && window[1..3].iter().all(|&c| c == Some(ai)) {
        if window[4].is_none() {
            // 确保右侧有足够空间 _OO__?
            ai_score += SCORE_LIVE_TWO;
        }
    } else if window[0].is_none()
        && window[3].is_none()
        && window[1..3].iter().all(|&c| c == Some(opp))
    {
        if window[4].is_none() {
            opp_score += SCORE_LIVE_TWO;
        }
    }
    // __OO__
    if window[1].is_none() && window[4].is_none() && window[2..4].iter().all(|&c| c == Some(ai)) {
        if window[0].is_none() && window[5].is_none() {
            // 需要两边都空
            ai_score += SCORE_LIVE_TWO;
        }
    } else if window[1].is_none()
        && window[4].is_none()
        && window[2..4].iter().all(|&c| c == Some(opp))
    {
        if window[0].is_none() && window[5].is_none() {
            opp_score += SCORE_LIVE_TWO;
        }
    }
    // ___OO_
    if window[2].is_none() && window[5].is_none() && window[3..5].iter().all(|&c| c == Some(ai)) {
        if window[1].is_none() {
            // 确保左侧有足够空间 __OO_?
            ai_score += SCORE_LIVE_TWO;
        }
    } else if window[2].is_none()
        && window[5].is_none()
        && window[3..5].iter().all(|&c| c == Some(opp))
    {
        if window[1].is_none() {
            opp_score += SCORE_LIVE_TWO;
        }
    }

    // 注意：这里的活棋判断比较基础，没有包含所有活二活三的变种（如跳活二 O_O_）。
    // 完整的评估函数会更复杂，需要匹配更多模式并精确计算权重。

    (ai_score, opp_score)
}

// --- ggez EventHandler Implementation ---

impl EventHandler<GameError> for GameState {
    // 更新逻辑
    fn update(&mut self, _ctx: &mut Context) -> GameResult {
        // 检查 AI 是否需要下棋
        if self.phase == GamePhase::Playing
            && self.current_player != self.human_player
            && !self.ai_thinking
        {
            self.trigger_ai_move();
        }

        // 检查 AI 计算结果
        if self.ai_thinking {
            self.handle_ai_result();
        }

        Ok(())
    }

    // 绘制逻辑
    fn draw(&mut self, ctx: &mut Context) -> GameResult {
        let mut canvas = graphics::Canvas::from_frame(ctx, Color::from_rgb(200, 150, 100)); // 木质背景色

        // --- 绘制棋盘网格 ---
        let grid_color = Color::from_rgb(50, 50, 50);
        for i in 0..BOARD_SIZE {
            // 水平线
            let y = MARGIN + i as f32 * CELL_SIZE;
            let p1 = Vec2::new(MARGIN, y);
            let p2 = Vec2::new(MARGIN + BOARD_DIM, y);
            canvas.draw(
                &graphics::Mesh::new_line(ctx, &[p1, p2], 1.0, grid_color)?,
                DrawParam::default(),
            );

            // 垂直线
            let x = MARGIN + i as f32 * CELL_SIZE;
            let p1 = Vec2::new(x, MARGIN);
            let p2 = Vec2::new(x, MARGIN + BOARD_DIM);
            canvas.draw(
                &graphics::Mesh::new_line(ctx, &[p1, p2], 1.0, grid_color)?,
                DrawParam::default(),
            );
        }

        // --- 绘制星位 ---
        let star_points = [
            (3, 3),
            (11, 3),
            (3, 11),
            (11, 11),
            (7, 7),
            (3, 7),
            (11, 7),
            (7, 3),
            (7, 11), // 可选添加更多
        ];
        for (x, y) in star_points {
            if x < BOARD_SIZE && y < BOARD_SIZE {
                let pos = self.grid_to_screen(x, y);
                canvas.draw(
                    &graphics::Mesh::new_circle(
                        ctx,
                        DrawMode::fill(),
                        pos,
                        DOT_RADIUS,
                        0.1,
                        grid_color,
                    )?,
                    DrawParam::default(),
                );
            }
        }

        // --- 绘制棋子 ---
        for r in 0..BOARD_SIZE {
            for c in 0..BOARD_SIZE {
                if let Some(player) = self.board[r][c] {
                    let pos = self.grid_to_screen(c, r);
                    let color = player.color();
                    // 画棋子边框（可选）
                    // canvas.draw(
                    //     &graphics::Mesh::new_circle(ctx, DrawMode::stroke(1.5), pos, PIECE_RADIUS, 0.1, Color::from_rgb(80, 80, 80))?,
                    //     DrawParam::default(),
                    // );
                    // 画棋子填充
                    canvas.draw(
                        &graphics::Mesh::new_circle(
                            ctx,
                            DrawMode::fill(),
                            pos,
                            PIECE_RADIUS,
                            0.1,
                            color,
                        )?,
                        DrawParam::default(),
                    );
                }
            }
        }

        // --- 标注最后一步棋 ---
        if let Some((x, y)) = self.last_move {
            let pos = self.grid_to_screen(x, y);
            let highlight_color = Color::new(1.0, 0.0, 0.0, 0.8); // 红色高亮
            let rect = Rect::new(
                pos.x - HIGHLIGHT_SIZE / 2.0,
                pos.y - HIGHLIGHT_SIZE / 2.0,
                HIGHLIGHT_SIZE,
                HIGHLIGHT_SIZE,
            );
            canvas.draw(
                &graphics::Mesh::new_rectangle(ctx, DrawMode::stroke(2.0), rect, highlight_color)?,
                DrawParam::default(),
            );
            // 或者画一个小红点
            // canvas.draw(
            //     &graphics::Mesh::new_circle(ctx, DrawMode::fill(), pos, HIGHLIGHT_SIZE * 0.5, 0.1, highlight_color)?,
            //     DrawParam::default(),
            // );
        }

        // --- 绘制状态文本 ---
        let text = Text::new(TextFragment {
            text: self.status_text.clone(),
            color: Some(Color::BLACK),
            font: Some("LiberationMono-Regular".into()), // 确保字体存在或替换为可用字体
            scale: Some(graphics::PxScale::from(20.0)),
            ..Default::default()
        });
        let text_pos = Vec2::new(MARGIN, WINDOW_HEIGHT - MARGIN / 2.0 - 10.0); // 放置在底部
        canvas.draw(&text, DrawParam::default().dest(text_pos));

        // --- 结束绘制 ---
        canvas.finish(ctx)?;
        Ok(())
    }

    // 鼠标点击事件
    fn mouse_button_down_event(
        &mut self,
        _ctx: &mut Context,
        button: MouseButton,
        x: f32,
        y: f32,
    ) -> GameResult {
        if button == MouseButton::Left {
            // 选择执子阶段不处理棋盘点击
            if self.phase != GamePhase::Playing {
                println!("Current phase is {:?}. Cannot place piece.", self.phase);
                return Ok(());
            }
            // AI 思考时不处理玩家点击
            if self.ai_thinking || self.current_player != self.human_player {
                println!("Not your turn or AI is thinking.");
                return Ok(());
            }

            if let Some((grid_x, grid_y)) = self.screen_to_grid(x, y) {
                match self.make_move(grid_x, grid_y, self.human_player) {
                    Ok(_) => {
                        println!(
                            "Player ({:?}) placed at ({}, {})",
                            self.human_player, grid_x, grid_y
                        );
                        // 切换到 AI 回合 (由 update 触发)
                    }
                    Err(e) => {
                        println!("Invalid move: {}", e);
                        // 可以加一个视觉反馈，比如闪烁一下
                    }
                }
            } else {
                println!("Clicked outside the board.");
            }
        }
        Ok(())
    }

    // 键盘按下事件
    fn key_down_event(
        &mut self,
        ctx: &mut Context,
        input: ggez::input::keyboard::KeyInput,
        _repeated: bool,
    ) -> GameResult {
        match input.keycode {
            Some(ggez::input::keyboard::KeyCode::U) => {
                if self.phase == GamePhase::Playing && !self.ai_thinking {
                    self.undo_move();
                } else {
                    println!("Cannot undo now (AI thinking or game not playing).");
                }
            }
            Some(ggez::input::keyboard::KeyCode::R) => {
                println!("Restarting game.");
                self.reset_game();
            }
            Some(ggez::input::keyboard::KeyCode::B) => {
                if self.phase == GamePhase::ChooseSide {
                    self.human_player = Player::Black;
                    self.phase = GamePhase::Playing;
                    println!("You chose Black. Game started.");
                    self.update_status_text();
                    // 人类执黑，不用触发 AI
                }
            }
            Some(ggez::input::keyboard::KeyCode::W) => {
                if self.phase == GamePhase::ChooseSide {
                    self.human_player = Player::White;
                    self.phase = GamePhase::Playing;
                    println!("You chose White. Game started. AI (Black) moves first.");
                    self.update_status_text();
                    // 人类执白，需要触发 AI (黑棋) 下第一步
                    self.trigger_ai_move();
                }
            }
            Some(ggez::input::keyboard::KeyCode::Escape) => {
                println!("Exiting game.");
                ctx.request_quit();
            }
            _ => {} // 其他按键忽略
        }
        Ok(())
    }
}

// --- Main Function ---
fn main() -> GameResult {
    let (mut ctx, event_loop) = ContextBuilder::new("gomoku_ggez", "Your Name")
        .window_setup(WindowSetup::default().title("Gomoku"))
        .window_mode(
            WindowMode::default()
                .dimensions(WINDOW_WIDTH, WINDOW_HEIGHT)
                .resizable(false),
        )
        .build()?;

    // 添加字体资源 (如果需要)
    // ctx.fs.add_zip_file(std::path::Path::new("resources.zip"))?;
    // 或者确保系统中有默认字体如 "LiberationMono-Regular"

    let state = GameState::new(&mut ctx)?;
    event::run(ctx, event_loop, state)
}
